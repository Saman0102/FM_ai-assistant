# LLM Configuration
LLM_PROVIDER=gemini  # Options: gemini, openai, claude, vllm
MODEL_NAME=gemini-3.6-flash
API_KEY=your_google_ai_studio_key_here
LLM_BASE_URL=
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048
API_TIMEOUT=30

# RAG Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
VECTOR_DB_TYPE=chroma  # Options: chroma, pinecone, weaviate
CHROMA_PERSIST_DIR=./chroma_data
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RESULTS=5

# Debug Mode
DEBUG=false

# Task 2 production settings
APP_PORT=8000
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=256
MAX_RETRIES=2
RETRY_DELAY_SECONDS=0.5
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional fallback provider
FALLBACK_PROVIDER=
FALLBACK_MODEL_NAME=gpt-4o-mini
FALLBACK_API_KEY=

# Local vLLM profile (use with LLM_PROVIDER=vllm)
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_HOST_PORT=8001
VLLM_TP_SIZE=1
HF_TOKEN=
