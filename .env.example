# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, claude, gemini, bedrock
MODEL_NAME=gpt-4-turbo
API_KEY=your_api_key_here
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048
API_TIMEOUT=30

# RAG Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
VECTOR_DB_TYPE=chroma  # Options: chroma, pinecone, weaviate
CHROMA_PERSIST_DIR=./chroma_data
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RESULTS=5

# Debug Mode
DEBUG=false

# Task 2 production settings
APP_PORT=8000
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=256
MAX_RETRIES=2
RETRY_DELAY_SECONDS=0.5
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional fallback provider
FALLBACK_PROVIDER=
FALLBACK_MODEL_NAME=gpt-4o-mini
FALLBACK_API_KEY=
